{
  "openapi": "3.1.0",
  "info": {
    "title": "claims-service",
    "version": "v1"
  },
  "security": [
    {
      "bearer": []
    }
  ],
  "paths": {
    "/internal/policies/verify": {
      "post": {
        "tags": [
          "policy-controller"
        ],
        "summary": "Internal (service token only): does this policy belong to this email?",
        "operationId": "verify",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/claims": {
      "get": {
        "tags": [
          "claim-controller"
        ],
        "summary": "Manager: all claims, newest first, optionally filtered by status and market",
        "operationId": "all",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "SUBMITTED",
                "UNDER_REVIEW",
                "INFO_REQUESTED",
                "ASSESSED",
                "SETTLED",
                "REJECTED"
              ]
            }
          },
          {
            "name": "market",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0,
              "minimum": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 20,
              "maximum": 100,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponseClaimSummary"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "claim-controller"
        ],
        "summary": "Claimant: open a claim on one of their own policies",
        "operationId": "open",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OpenClaimRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClaimDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/claims/{id}/settlement": {
      "post": {
        "tags": [
          "claim-controller"
        ],
        "summary": "Assigned officer: settle an ASSESSED claim (max: sum insured)",
        "operationId": "settle",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettlementRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClaimDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/claims/{id}/rejection": {
      "post": {
        "tags": [
          "claim-controller"
        ],
        "summary": "Assigned officer: reject the claim",
        "operationId": "reject",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RejectionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClaimDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/claims/{id}/information-requests": {
      "get": {
        "tags": [
          "claim-controller"
        ],
        "summary": "Information requests, oldest first",
        "operationId": "informationRequests",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/InformationRequestView"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "claim-controller"
        ],
        "summary": "Assigned officer: ask the claimant for more information",
        "operationId": "requestInformation",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InformationRequestBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClaimDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/claims/{id}/information-requests/{requestId}/response": {
      "post": {
        "tags": [
          "claim-controller"
        ],
        "summary": "Claim owner: answer the open information request (text only for now)",
        "operationId": "respond",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "requestId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InformationResponseBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClaimDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/claims/{id}/documents": {
      "get": {
        "tags": [
          "document-controller"
        ],
        "summary": "Document metadata, newest first (owner, officers of the claim's market, manager)",
        "operationId": "list",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DocumentView"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "document-controller"
        ],
        "summary": "Claim owner: upload a JPEG, PNG or PDF (max 10 MB, 20 per claim), optionally for an open information request",
        "operationId": "upload",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "informationRequestId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "required": [
                  "file"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentView"
                }
              }
            }
          }
        }
      }
    },
    "/api/claims/{id}/assign": {
      "post": {
        "tags": [
          "claim-controller"
        ],
        "summary": "Officer: pick up a SUBMITTED claim (assigns it to me)",
        "operationId": "assign",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClaimDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/claims/{id}/assessment": {
      "post": {
        "tags": [
          "claim-controller"
        ],
        "summary": "Assigned officer: set or update the reserve (max: sum insured)",
        "operationId": "assess",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssessmentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClaimDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/policies/my": {
      "get": {
        "tags": [
          "policy-controller"
        ],
        "summary": "Policies whose holder email matches the caller's email",
        "operationId": "myPolicies",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Policy"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/claims/{id}": {
      "get": {
        "tags": [
          "claim-controller"
        ],
        "summary": "Claim detail (owner, officers of its market, manager)",
        "operationId": "get",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClaimDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/claims/{id}/history": {
      "get": {
        "tags": [
          "claim-controller"
        ],
        "summary": "Status history, oldest first",
        "operationId": "history",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HistoryEntry"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/claims/{id}/documents/{documentId}/content": {
      "get": {
        "tags": [
          "document-controller"
        ],
        "summary": "Download a document (same access as the list)",
        "operationId": "content",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "documentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    },
    "/api/claims/queue": {
      "get": {
        "tags": [
          "claim-controller"
        ],
        "summary": "Officer: unassigned SUBMITTED claims in my market, oldest first",
        "operationId": "queue",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ClaimSummary"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/claims/my": {
      "get": {
        "tags": [
          "claim-controller"
        ],
        "summary": "Claimant: my claims, newest first",
        "operationId": "my",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ClaimSummary"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/claims/assigned": {
      "get": {
        "tags": [
          "claim-controller"
        ],
        "summary": "Officer: my open claims",
        "operationId": "assigned",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ClaimSummary"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "VerifyRequest": {
        "type": "object",
        "properties": {
          "policyNumber": {
            "type": "string",
            "maxLength": 30,
            "minLength": 0
          },
          "email": {
            "type": "string",
            "maxLength": 255,
            "minLength": 0
          }
        },
        "required": [
          "email",
          "policyNumber"
        ]
      },
      "VerifyResponse": {
        "type": "object",
        "properties": {
          "match": {
            "type": "boolean"
          },
          "holderName": {
            "type": "string"
          }
        }
      },
      "OpenClaimRequest": {
        "type": "object",
        "properties": {
          "policyId": {
            "type": "string",
            "format": "uuid"
          },
          "incidentDate": {
            "type": "string",
            "format": "date"
          },
          "incidentLocation": {
            "type": "string",
            "maxLength": 255,
            "minLength": 0
          },
          "description": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 0
          },
          "claimedAmount": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "claimedAmount",
          "description",
          "incidentDate",
          "incidentLocation",
          "policyId"
        ]
      },
      "ClaimDetail": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "claimNumber": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "type": "string",
            "enum": [
              "SUBMITTED",
              "UNDER_REVIEW",
              "INFO_REQUESTED",
              "ASSESSED",
              "SETTLED",
              "REJECTED"
            ]
          },
          "policyId": {
            "type": "string",
            "format": "uuid"
          },
          "policyNumber": {
            "type": "string"
          },
          "sumInsured": {
            "type": "number"
          },
          "type": {
            "type": "string"
          },
          "market": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "incidentDate": {
            "type": "string",
            "format": "date"
          },
          "incidentLocation": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "claimedAmount": {
            "type": "number"
          },
          "reserveAmount": {
            "type": "number"
          },
          "settledAmount": {
            "type": "number"
          },
          "rejectionReason": {
            "type": "string"
          },
          "claimantId": {
            "type": "string",
            "format": "uuid"
          },
          "claimantName": {
            "type": "string"
          },
          "assignedOfficerId": {
            "type": "string",
            "format": "uuid"
          },
          "assignedOfficerName": {
            "type": "string"
          },
          "assignedAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "closedAt": {
            "type": "string",
            "format": "date-time"
          },
          "openInformationRequest": {
            "$ref": "#/components/schemas/InformationRequestView"
          }
        }
      },
      "InformationRequestView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "question": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "RESPONDED"
            ]
          },
          "responseText": {
            "type": "string"
          },
          "requestedById": {
            "type": "string",
            "format": "uuid"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "respondedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SettlementRequest": {
        "type": "object",
        "properties": {
          "settledAmount": {
            "type": "number",
            "minimum": 0
          },
          "note": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 0
          }
        },
        "required": [
          "settledAmount"
        ]
      },
      "RejectionRequest": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 0
          }
        },
        "required": [
          "reason"
        ]
      },
      "InformationRequestBody": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 0
          }
        },
        "required": [
          "question"
        ]
      },
      "InformationResponseBody": {
        "type": "object",
        "properties": {
          "responseText": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 0
          }
        },
        "required": [
          "responseText"
        ]
      },
      "DocumentView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "informationRequestId": {
            "type": "string",
            "format": "uuid"
          },
          "originalFilename": {
            "type": "string"
          },
          "contentType": {
            "type": "string"
          },
          "sizeBytes": {
            "type": "integer",
            "format": "int64"
          },
          "uploadedById": {
            "type": "string",
            "format": "uuid"
          },
          "uploadedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AssessmentRequest": {
        "type": "object",
        "properties": {
          "reserveAmount": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "note": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 0
          }
        },
        "required": [
          "reserveAmount"
        ]
      },
      "Policy": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "policyNumber": {
            "type": "string"
          },
          "holderName": {
            "type": "string"
          },
          "productType": {
            "type": "string"
          },
          "market": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "insuredItem": {
            "type": "string"
          },
          "sumInsured": {
            "type": "number"
          },
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "type": "string"
          },
          "inForceToday": {
            "type": "boolean"
          }
        }
      },
      "ClaimSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "claimNumber": {
            "type": "string"
          },
          "policyNumber": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "market": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "incidentDate": {
            "type": "string",
            "format": "date"
          },
          "claimedAmount": {
            "type": "number"
          },
          "reserveAmount": {
            "type": "number"
          },
          "settledAmount": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "SUBMITTED",
              "UNDER_REVIEW",
              "INFO_REQUESTED",
              "ASSESSED",
              "SETTLED",
              "REJECTED"
            ]
          },
          "claimantName": {
            "type": "string"
          },
          "assignedOfficerName": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
