{
  "$schema": "./node_modules/@openapitools/openapi-generator-cli/config.schema.json",
  "spaces": 2,
  "generator-cli": {
    "version": "7.27.0",
    "generators": {
      "auth": {
        "generatorName": "typescript-angular",
        "inputSpec": "openapi/auth.json",
        "output": "src/app/api/auth",
        "additionalProperties": { "ngVersion": "22.0.0", "fileNaming": "kebab-case", "supportsES6": true, "stringEnums": true }
      },
      "claims": {
        "generatorName": "typescript-angular",
        "inputSpec": "openapi/claims.json",
        "output": "src/app/api/claims",
        "additionalProperties": { "ngVersion": "22.0.0", "fileNaming": "kebab-case", "supportsES6": true, "stringEnums": true }
      },
      "reporting": {
        "generatorName": "typescript-angular",
        "inputSpec": "openapi/reporting.json",
        "output": "src/app/api/reporting",
        "additionalProperties": { "ngVersion": "22.0.0", "fileNaming": "kebab-case", "supportsES6": true, "stringEnums": true }
      }
    }
  }
}
